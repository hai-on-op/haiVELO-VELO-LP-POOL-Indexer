{
  "name": "haivelo-pool-graph",
  "version": "1.0.0",
  "description": "Squid indexer for Velodrome haiVELO pool events",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "codegen": "squid-typeorm-codegen",
    "typegen": "squid-evm-typegen src/abi abi/pool.json --clean",
    "process": "node lib/main.js",
    "serve": "squid-graphql-server",
    "migration:generate": "squid-typeorm-migration generate",
    "migration:apply": "squid-typeorm-migration apply",
    "up": "docker compose up -d",
    "down": "docker compose down"
  },
  "dependencies": {
    "@subsquid/evm-abi": "^0.3.1",
    "@subsquid/evm-processor": "^1.27.3",
    "@subsquid/graphql-server": "^4.11.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.5.1",
    "dotenv": "^17.2.3",
    "pg": "^8.13.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^4.5.1",
    "@subsquid/typeorm-codegen": "^2.0.2",
    "typescript": "^5.9.3"
  }
}


