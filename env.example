# ===========================================
# Database Connection
# ===========================================

# Local development (with docker-compose)
DB_HOST=localhost
DB_PORT=23798
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres

# Production example (your VPS PostgreSQL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=haivelo_pool
# DB_USER=your_user
# DB_PASS=your_secure_password

# SSL mode for production databases that require SSL
# Set to "true" to enable SSL connection
# DB_SSL=true

# Alternative: Use a full DATABASE_URL (overrides individual DB_* vars)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ===========================================
# RPC Endpoint (optional)
# ===========================================
# The indexer uses Subsquid archive by default, but you can add your own RPC
# for better performance and to stay up-to-date with the latest blocks
# RPC_OPTIMISM_HTTP=https://mainnet.optimism.io
# RPC_OPTIMISM_HTTP=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ===========================================
# GraphQL Server
# ===========================================
# Port for the GraphQL API server (defaults to 4000)
# GQL_PORT=4000


